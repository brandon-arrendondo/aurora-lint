{
 "corpus": "sqlite",
 "platform": "linux-x86_64",
 "base": {
  "archive": "debian",
  "suite": "bookworm",
  "arch": "amd64",
  "snapshot": "20260915T000000Z",
  "release_sha256": "abcf5882746e0f68171f41adbb4ac01b74b49d62d203379befb9265804311a4f"
 },
 "roots": [
  "usr/include",
  "usr/lib/gcc/x86_64-linux-gnu/12/include"
 ],
 "prune": [
  "usr/include/linux/netfilter/xt_CONNMARK.h",
  "usr/include/linux/netfilter/xt_DSCP.h",
  "usr/include/linux/netfilter/xt_MARK.h",
  "usr/include/linux/netfilter/xt_RATEEST.h",
  "usr/include/linux/netfilter/xt_TCPMSS.h",
  "usr/include/linux/netfilter_ipv4/ipt_ECN.h",
  "usr/include/linux/netfilter_ipv4/ipt_TTL.h",
  "usr/include/linux/netfilter_ipv6/ip6t_HL.h"
 ],
 "include_dirs": [
  "usr/lib/gcc/x86_64-linux-gnu/12/include",
  "usr/include/x86_64-linux-gnu",
  "usr/include"
 ],
 "other_platform": [
  "src/os_win.c",
  "src/os_win.h",
  "ext/misc/windirent.h",
  "ext/misc/sqlite3_stdio.c"
 ],
 "exclude": {
  "libc6-dev-i386": "-m32 multilib; not the x86_64 configuration",
  "libc6-dev-x32": "x32 ABI; not the x86_64 configuration",
  "libowfat-dev": "its io.h shadows the Windows CRT header of that name, which the corpus includes only under _WIN32",
  "libsqlite3-dev": "ships a copy of the corpus's own headers (an older release)",
  "libsqlcipher-dev": "ships a copy of the corpus's own headers (an older release)"
 },
 "build": {
  "steps": [
   "./configure",
   "bear -- make USE_AMALGAMATION=0 -j\"$(nproc)\""
  ],
  "db": "$SRC/compile_commands.json",
  "packages": [
   "zlib1g-dev",
   "libreadline-dev"
  ],
  "apt": [
   "tcl"
  ],
  "why": "The default autosetup build (SQLITE_OS_UNIX, compile-time limits at their defaults), one translation unit per source file (USE_AMALGAMATION=0) so the database has an entry per file. Its generated headers (sqlite_cfg.h, sqlite3.h, parse.h, opcodes.h, keywordhash.h, pragma.h, fts5.h, fts5parse.h) are written into the checkout copy and searched after it. tclsh runs the build's generators."
 },
 "manifest_sha256": "0c1b8225ae6e1acad2f8c8a1060dcbb9b126df982602372e9ba85698e39b8b2e",
 "why": {
  "libc6-dev": "assert.h",
  "libgcc-12-dev": "stdarg.h",
  "libicu-dev": "unicode/ubrk.h",
  "linux-libc-dev": "linux/mount.h",
  "zlib1g-dev": "zlib.h"
 },
