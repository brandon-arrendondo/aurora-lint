  "src/platforms/rcore_web_emscripten.c"
 ],
 "exclude": {
  "libc6-dev-i386": "-m32 multilib; not the x86_64 configuration",
  "libc6-dev-x32": "x32 ABI; not the x86_64 configuration",
  "libowfat-dev": "its io.h shadows the Windows CRT header of that name, which the corpus includes only under _WIN32",
  "libglfw3-dev": "the corpus bundles its own GLFW (src/external/glfw), which its build uses; a system copy would shadow it"
 },
 "build": {
  "steps": [
   "cmake -S \"$SRC\" -B \"$BUILD\" -DCMAKE_EXPORT_COMPILE_COMMANDS=ON",
   "cmake --build \"$BUILD\" -j\"$(nproc)\""
  ],
  "db": "$BUILD/compile_commands.json",
  "packages": [
   "libgl1-mesa-dev",
   "libx11-dev",
   "libxrandr-dev",
   "libxinerama-dev",
   "libxcursor-dev",
   "libxi-dev",
   "libwayland-dev",
   "libxkbcommon-dev"
  ],
  "apt": [
   "libwayland-bin",
   "wayland-protocols"
  ],
  "why": "CMake defaults: PLATFORM_DESKTOP_GLFW, GLFW's X11 and Wayland backends, OpenGL. rcore.c includes exactly one platforms/*.c."
 },
