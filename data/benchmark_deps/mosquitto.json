{
 "corpus": "mosquitto",
 "platform": "linux-x86_64",
 "base": {
  "archive": "debian",
  "suite": "bookworm",
  "arch": "amd64",
  "snapshot": "20260915T000000Z",
  "release_sha256": "abcf5882746e0f68171f41adbb4ac01b74b49d62d203379befb9265804311a4f"
 },
 "roots": [
  "usr/include",
  "usr/lib/gcc/x86_64-linux-gnu/12/include"
 ],
 "prune": [
  "usr/include/linux/netfilter/xt_CONNMARK.h",
  "usr/include/linux/netfilter/xt_DSCP.h",
  "usr/include/linux/netfilter/xt_MARK.h",
  "usr/include/linux/netfilter/xt_RATEEST.h",
  "usr/include/linux/netfilter/xt_TCPMSS.h",
  "usr/include/linux/netfilter_ipv4/ipt_ECN.h",
  "usr/include/linux/netfilter_ipv4/ipt_TTL.h",
  "usr/include/linux/netfilter_ipv6/ip6t_HL.h"
 ],
 "include_dirs": [
  "usr/lib/gcc/x86_64-linux-gnu/12/include",
  "usr/include/x86_64-linux-gnu",
  "usr/include",
  "usr/include/cjson"
 ],
 "other_platform": [
  "src/service.c"
 ],
 "exclude": {
  "libc6-dev-i386": "-m32 multilib; not the x86_64 configuration",
  "libc6-dev-x32": "x32 ABI; not the x86_64 configuration",
  "libowfat-dev": "its io.h shadows the Windows CRT header of that name, which the corpus includes only under _WIN32",
  "libmosquitto-dev": "ships a copy of the corpus's own headers (an older release)",
  "uthash-dev": "the corpus bundles its own uthash (deps/uthash.h), which its build uses; a system copy would shadow it"
 },
 "build": {
  "steps": [
   "cmake -S \"$SRC\" -B \"$BUILD\" -DCMAKE_EXPORT_COMPILE_COMMANDS=ON -DWITH_DOCS=OFF -DWITH_TESTS=OFF",
   "cmake --build \"$BUILD\" -j\"$(nproc)\""
  ],
  "db": "$BUILD/compile_commands.json",
  "packages": [
   "libssl-dev",
   "libcjson-dev",
   "libsqlite3-dev",
   "libmicrohttpd-dev"
  ],
  "why": "CMake defaults (the declared default Linux build: TLS, builtin websockets, HTTP API, plugins, ctrl shell), except WITH_DOCS=OFF (the man pages need xsltproc) and WITH_TESTS=OFF (the C++ GTest suite, outside the scan scope). The build installs only 'packages' from the set (plus the C library, compiler and kernel headers), so an optional library the set carries for other configurations cannot switch on an autodetected feature."
 },
 "manifest_sha256": "9585ca5a9f303235f637ce7a72f10f78868e0ea6475d72808956db7ddb8a52a4",
 "why": {
  "libc-ares-dev": "ares.h",
  "libc6-dev": "arpa/inet.h",
  "libcap-dev": "sys/capability.h",
  "libcjson-dev": "cjson/cJSON.h",
  "libdlt-dev": "dlt/dlt.h",
  "libgcc-12-dev": "stdarg.h",
  "libmbedtls-dev": "mbedtls/ssl.h",
  "libmicrohttpd-dev": "microhttpd.h",
  "libsqlite3-dev": "sqlite3.h",
  "libssl-dev": "openssl/bn.h",
  "libsystemd-dev": "systemd/sd-daemon.h",
  "libuv1-dev": "uv.h",
  "libwebsockets-dev": "libwebsockets.h",
  "libwolfssl-dev": "cyassl/ctaocrypt/settings.h",
  "libwrap0-dev": "tcpd.h",
  "linux-libc-dev": "linux/in.h",
  "zlib1g-dev": "zlib.h"
 },
