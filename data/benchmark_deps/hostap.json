  "libowfat-dev": "its io.h shadows the Windows CRT header of that name, which the corpus includes only under _WIN32"
 },
 "build": {
  "steps": [
   "cp wpa_supplicant/defconfig wpa_supplicant/.config",
   "cp hostapd/defconfig hostapd/.config",
   "bear --output \"$BUILD/compile_commands.json\" -- make -C wpa_supplicant -j\"$(nproc)\"",
   "bear --append --output \"$BUILD/compile_commands.json\" -- make -C hostapd -j\"$(nproc)\""
  ],
  "db": "$BUILD/compile_commands.json",
  "packages": [
   "libssl-dev",
   "libnl-3-dev",
   "libnl-genl-3-dev",
   "libnl-route-3-dev",
   "libdbus-1-dev",
   "pkg-config"
  ],
  "why": "wpa_supplicant and hostapd at their shipped defconfigs (the declared configuration: nl80211, wext, wired and MACsec drivers, os_unix, l2_packet_linux, OpenSSL, D-Bus control interface)."
 },
