  "libc6-dev-i386": "-m32 multilib; not the x86_64 configuration",
  "libc6-dev-x32": "x32 ABI; not the x86_64 configuration",
  "libowfat-dev": "its io.h shadows the Windows CRT header of that name, which the corpus includes only under _WIN32",
  "libjemalloc-dev": "the corpus bundles its own jemalloc (deps/jemalloc); its build generates that copy's jemalloc/jemalloc.h, which a system copy would shadow"
 },
 "build": {
  "steps": [
   "bear -- make -j\"$(nproc)\""
  ],
  "db": "$SRC/compile_commands.json",
  "packages": [],
  "apt": [
   "python3"
  ],
  "why": "The default server build: make with the Makefile's defaults (jemalloc from deps/, BUILD_TLS=no, no systemd or RDMA). Its generated headers (deps/jemalloc/include/jemalloc/jemalloc.h, src/release.h) are written into the checkout copy and searched after their source directory."
 },
