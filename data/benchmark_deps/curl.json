{
 "corpus": "curl",
 "platform": "linux-x86_64",
 "base": {
  "archive": "debian",
  "suite": "bookworm",
  "arch": "amd64",
  "snapshot": "20260915T000000Z",
  "release_sha256": "abcf5882746e0f68171f41adbb4ac01b74b49d62d203379befb9265804311a4f"
 },
 "roots": [
  "usr/include",
  "usr/lib/gcc/x86_64-linux-gnu/12/include"
 ],
 "prune": [
  "usr/include/linux/netfilter",
  "usr/include/linux/netfilter_ipv4",
  "usr/include/linux/netfilter_ipv6"
 ],
 "include_dirs": [
  "usr/lib/gcc/x86_64-linux-gnu/12/include",
  "usr/include/x86_64-linux-gnu",
  "usr/include"
 ],
 "exclude": {
  "libc6-dev-i386": "-m32 multilib; not the x86_64 configuration",
  "libc6-dev-x32": "x32 ABI; not the x86_64 configuration",
  "libowfat-dev": "io.h is the Windows CRT header, included only under _WIN32",
  "libgnutls28-dev": "CURL_USE_GNUTLS defaults OFF (the declared build is OpenSSL)",
  "libmbedtls-dev": "CURL_USE_MBEDTLS defaults OFF",
  "libwolfssl-dev": "CURL_USE_WOLFSSL defaults OFF",
  "libc-ares-dev": "ENABLE_ARES defaults OFF",
  "libssh-dev": "CURL_USE_LIBSSH defaults OFF (libssh2 is the default SSH backend)",
  "libngtcp2-dev": "USE_NGTCP2 defaults OFF",
  "libnghttp3-dev": "USE_NGTCP2 defaults OFF (nghttp3 comes with it)",
  "libngtcp2-crypto-gnutls-dev": "USE_NGTCP2 defaults OFF",
  "libkrb5-dev": "CURL_USE_GSSAPI defaults OFF",
  "heimdal-dev": "CURL_USE_GSSAPI defaults OFF",
  "heimdal-multidev": "CURL_USE_GSSAPI defaults OFF",
  "libgsasl-dev": "CURL_USE_GSASL defaults OFF",
  "libgsasl7-dev": "CURL_USE_GSASL defaults OFF",
  "librtmp-dev": "USE_LIBRTMP defaults OFF",
  "libuv1-dev": "CURL_USE_LIBUV defaults OFF (tests only)",
  "libcurl4-openssl-dev": "the corpus's own headers, older release",
  "libcurl4-gnutls-dev": "the corpus's own headers, older release",
  "libcurl4-nss-dev": "the corpus's own headers, older release",
  "libdmalloc-dev": "dmalloc is a debugging allocator no default build uses",
  "libev-dev": "docs/examples only (not part of the library or tool build)",
  "libevent-dev": "docs/examples only (not part of the library or tool build)",
  "libexpat1-dev": "docs/examples only (not part of the library or tool build)",
  "libtidy-dev": "docs/examples only (not part of the library or tool build)",
  "libicu-dev": "lib/idn.c includes it only under USE_APPLE_IDN",
  "libgss-dev": "lib/urldata.h includes gss.h only with HAVE_GSSAPI (CURL_USE_GSSAPI defaults OFF)",
  "libssh-gcrypt-dev": "CURL_USE_LIBSSH defaults OFF (libssh2 is the default SSH backend)",
  "nettle-dev": "lib/curl_ntlm_core.c includes it only under USE_GNUTLS"
 },
 "build": {
  "steps": [
   "cmake -S \"$SRC\" -B \"$BUILD\" -DCMAKE_EXPORT_COMPILE_COMMANDS=ON -DCURL_ZLIB=ON -DCURL_BROTLI=ON -DCURL_ZSTD=ON",
   "cmake --build \"$BUILD\" -j\"$(nproc)\""
  ],
  "db": "$BUILD/compile_commands.json",
  "why": "CMake defaults: OpenSSL, nghttp2, libidn2, libpsl, libssh2 and LDAP on, every other TLS backend, c-ares, GSSAPI, libssh, HTTP/3, gsasl, rtmp and libuv off. zlib, brotli and zstd are autodetected by default; the recipe turns them on explicitly so a missing package fails the build instead of changing it."
 },
 "manifest_sha256": "2ed1a74bd1a7e20dde35535b3b13eae2105c6356a94232515b52929015507dfe",
 "why": {
  "libbrotli-dev": "brotli/decode.h",
  "libc6-dev": "arpa/inet.h",
  "libgcc-12-dev": "backtrace.h",
  "libidn2-dev": "idn2.h",
  "libldap-dev": "lber.h",
  "libnghttp2-dev": "nghttp2/nghttp2.h",
  "libpsl-dev": "libpsl.h",
  "libssh2-1-dev": "libssh2.h",
  "libssl-dev": "openssl/bio.h",
  "libzstd-dev": "zstd.h",
  "linux-libc-dev": "linux/tcp.h",
  "zlib1g-dev": "zlib.h"
 },
