  "usr/lib/gcc/x86_64-linux-gnu/12/include",
  "usr/include/x86_64-linux-gnu",
  "usr/include"
 ],
 "exclude": {
  "libc6-dev-i386": "-m32 multilib; not the x86_64 configuration",
  "libc6-dev-x32": "x32 ABI; not the x86_64 configuration",
  "libowfat-dev": "its io.h shadows the Windows CRT header of that name, which the corpus includes only under _WIN32",
  "libcurl4-openssl-dev": "ships a copy of the corpus's own headers (an older release)",
  "libcurl4-gnutls-dev": "ships a copy of the corpus's own headers (an older release)",
  "libcurl4-nss-dev": "ships a copy of the corpus's own headers (an older release)"
 },
 "build": {
  "steps": [
   "cmake -S \"$SRC\" -B \"$BUILD\" -DCMAKE_EXPORT_COMPILE_COMMANDS=ON -DCURL_ZLIB=ON -DCURL_BROTLI=ON -DCURL_ZSTD=ON",
   "cmake --build \"$BUILD\" -j\"$(nproc)\""
  ],
  "db": "$BUILD/compile_commands.json",
  "packages": [
   "libssl-dev",
   "libnghttp2-dev",
   "libidn2-dev",
   "libpsl-dev",
   "libssh2-1-dev",
   "libldap-dev",
   "zlib1g-dev",
   "libbrotli-dev",
   "libzstd-dev"
  ],
  "why": "CMake defaults: OpenSSL, nghttp2, libidn2, libpsl, libssh2 and LDAP on, every other TLS backend, c-ares, GSSAPI, libssh, HTTP/3, gsasl, rtmp and libuv off. zlib, brotli and zstd are autodetected by default; the recipe turns them on explicitly so a missing package fails the build instead of changing it. The build installs only 'packages' from the set (plus the C library, compiler and kernel headers), so an optional library the set carries for other configurations cannot switch on an autodetected feature."
 },
 "manifest_sha256": "e75d8dec336a0c90775805160404ad9adc7aadd34aa468ff21ad9f16c7811e4f",
