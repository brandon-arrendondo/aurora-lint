# Machine-local benchmark configuration. Copy to .env (gitignored) and adjust,
# or export these directly in your shell -- either way bench/config.py picks
# them up (a real environment variable always wins over .env).

# Base directory holding the Juliet test suite
# (benchmarks/juliet-test-suite-c/testcases/) and every real-world codebase
# checkout (libcrc/, sqlite/, mosquitto/, curl/, hostap/, lua/, raylib/,
# pureftpd/, sel4/). Provisioned by playbooks/setup-benchmark-repos.yml.
SQC_BENCH_ROOT=~/toolchain

# Override the benchmark results database (rarely needed -- mainly for tests
# or scoring an alternate corpus without touching data/benchmarks.db).
#BENCH_DB=data/benchmarks.db

# Opt this node into the shared Postgres benchmark DB instead of the default
# local SQLite file (task 638, BENCHMARK_POSTGRES_MIGRATION_PLAN.md). Unset
# (the default) keeps a single-node contributor's workflow at zero setup --
# only set this on a node that's meant to read/write the shared instance.
# Use the sqc_writer role (SELECT/INSERT/UPDATE/DELETE on the operational
# tables, SELECT-only on ground_truth -- never the sqc_migrate owner
# credential here). Rollback is just unsetting this var; data/benchmarks.db
# stays untouched and readable as the fallback.
#SQC_BENCH_DSN=host=<pg-host> dbname=sqc_bench user=sqc_writer password=<...>

# For an ACTIVE ADJUDICATION session (realworld-import-labels, calibration-
# import, or any oracle-freezing tool) instead of running benchmarks: point
# this same var at the sqc_adjudicate role (task 637,
# bench/postgres_migration/08_adjudication_role.sql) in that terminal only.
# It can write ground_truth/calibration_labels/audited_files/
# audit_corpus_meta/oracle_versions but nothing else -- sqc_writer is
# deliberately denied that access so an automated benchmark run can never
# touch the oracle. Don't use sqc_adjudicate for routine benchmark runs, and
# don't widen sqc_writer's grants to cover this instead.
#SQC_BENCH_DSN=host=<pg-host> dbname=sqc_bench user=sqc_adjudicate password=<...>
